# ---------------------------------------------------------------------------
# CINEVA — variables d'environnement (build-time, exposées au navigateur)
#
# ATTENTION : tout ce qui commence par VITE_ est intégré EN CLAIR dans le build
# et donc visible par n'importe quel visiteur (GitHub Pages = statique).
# Ne mettez ici QUE des valeurs publiques : clés API de lecture seule, URLs.
#
# Copiez ce fichier en `.env` pour le développement local.
# ---------------------------------------------------------------------------

# Clé API TMDB v3 (publique, côté client, à restreindre par domaine dans TMDB).
VITE_TMDB_API_KEY=96abd37471b06f5450f26f4d1a2ee7fa

# Langue des métadonnées TMDB (fr-FR, en-US, ...).
VITE_TMDB_LANGUAGE=fr-FR

# ---------------------------------------------------------------------------
# Disponibilité légale (« Où regarder »)
# ---------------------------------------------------------------------------
# Pays interrogé (ISO 3166-1 alpha-2).
VITE_WATCH_REGION=FR

# Watchmode — clé gratuite : https://api.watchmode.com/requestApiKey/
# (offre gratuite non commerciale, 2 500 crédits/mois, sources de 3 pays).
VITE_WATCHMODE_API_KEY=

# Streaming Availability (Movie of the Night) — clé gratuite :
# https://developers.movieofthenight.com/
VITE_STREAMING_AVAILABILITY_API_KEY=

# ---------------------------------------------------------------------------
# Lecture
# ---------------------------------------------------------------------------
# Facultatif : flux HLS/MP4 public de démonstration, utilisé UNIQUEMENT pour
# tester le lecteur quand aucune source locale n'est déclarée.
VITE_DEMO_STREAM_URL=
