# ---------------------------------------------------------------------------
# CINEVA — variables d'environnement (build-time, exposées au navigateur)
#
# ATTENTION : tout ce qui commence par VITE_ est intégré EN CLAIR dans le build
# et donc visible par n'importe quel visiteur (GitHub Pages = statique).
# Ne mettez ici QUE des valeurs publiques : clé TMDB v3, URL d'API publique.
# Aucun secret (mot de passe, clé privée, token OAuth) ne doit y figurer.
#
# Copiez ce fichier en `.env` pour le développement local.
# ---------------------------------------------------------------------------

# Clé API TMDB v3 (publique, côté client, à restreindre par domaine dans TMDB).
# Une clé TMDB v3 valide fait 32 caractères hexadécimaux.
VITE_TMDB_API_KEY=96abd37471b06f5450f26f4d1a2ee7fa

# Langue des métadonnées renvoyées par TMDB (fr-FR, en-US, ...).
VITE_TMDB_LANGUAGE=fr-FR

# ---------------------------------------------------------------------------
# Résolution des flux vidéo (backend requis, GitHub Pages ne peut pas en héberger)
# ---------------------------------------------------------------------------
# CinePro Core : instance HTTP déjà déployée (https://github.com/cinepro-org/core).
# Laissez vide pour désactiver ce résolveur.
VITE_CINEPRO_API_URL=

# AutoFlix : petit service HTTP exposant l'API Python d'autoflix-cli
# (https://github.com/PaulExplorer/autoflix-cli) derrière une route REST.
# Laissez vide pour désactiver ce résolveur.
VITE_AUTOFLIX_API_URL=

# Facultatif : flux HLS public de démonstration (ex. un sample Mux / Big Buck Bunny)
# utilisé UNIQUEMENT pour tester le lecteur quand aucun résolveur n'est configuré.
# Le site n'affiche jamais de contenu sans source légale configurée.
VITE_DEMO_STREAM_URL=
